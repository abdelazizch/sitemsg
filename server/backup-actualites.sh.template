#!/bin/sh
# Sauvegarde quotidienne du volume actualites_data (base SQLite + images uploadées).
# Installation sur le serveur (pas exécuté automatiquement par ce dépôt) :
#   1. Copier ce fichier vers ~/projects/site_lemessage/backup-actualites.sh
#   2. chmod +x ~/projects/site_lemessage/backup-actualites.sh
#   3. Ajouter au crontab (crontab -e) :
#      0 3 * * * /home/dmo/projects/site_lemessage/backup-actualites.sh >> /home/dmo/projects/site_lemessage/backup.log 2>&1

set -e

BACKUP_DIR="$HOME/backups/actualites"
VOLUME_NAME="site_lemessage_actualites_data"
DATE=$(date +%Y%m%d-%H%M%S)

mkdir -p "$BACKUP_DIR"

docker run --rm \
  -v "${VOLUME_NAME}:/data:ro" \
  -v "${BACKUP_DIR}:/backup" \
  alpine \
  sh -c "tar czf /backup/actualites-${DATE}.tar.gz -C / data"

# Conserve les 7 sauvegardes les plus récentes, supprime le reste.
cd "$BACKUP_DIR"
ls -1t actualites-*.tar.gz 2>/dev/null | tail -n +8 | xargs -r rm --

echo "Sauvegarde terminée : ${BACKUP_DIR}/actualites-${DATE}.tar.gz"
